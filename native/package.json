{
  "name": "sumsum-native",
  "private": true,
  "version": "1.0.0",
  "description": "셈셈 놀이터 iOS·Android 앱 (Capacitor). 게임 파일은 ../app 을 복사해서 앱 안에 넣어요.",
  "scripts": {
    "build": "node build.mjs",
    "sync": "node build.mjs && npx cap sync",
