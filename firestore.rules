// 셈셈 놀이터 순위표 보안 규칙
// - 누구나 읽을 수 있어요.
// - 새 기록 추가만 돼요. 고치거나 지우기는 막아요.
// - 이름은 1~8글자(한글·영문·숫자·_·공백), 점수는 말이 되는 범위만 받아요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{mode}/scores/{id} {
      allow read: if mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf'];

      allow create: if mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf']
        && request.resource.data.keys().hasOnly(['name', 'score', 'at', 'v'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 8
        && request.resource.data.name.matches('^[가-힣A-Za-z0-9_ ]+$')
        && request.resource.data.score is number
        && request.resource.data.at == request.time
        && request.resource.data.v == 1
        && (
          (mode == 'race'
            && request.resource.data.score >= 20
            && request.resource.data.score <= 3600)
          || (mode != 'race'
            && request.resource.data.score is int
            && request.resource.data.score > 0
            && request.resource.data.score <= 200000
            && request.resource.data.score % 5 == 0)
        );

      allow update, delete: if false;
    }

    // 앱 명예의 전당: 사람(기기)마다 한 줄. 더 좋은 기록으로만 고칠 수 있어요.
    match /boards/{mode}/players/{pid} {
      function okMode() { return mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf']; }
      function ok(d) {
        return d.keys().hasOnly(['name', 'score', 'at', 'v'])
          && d.name is string
          && d.name.size() >= 1
          && d.name.size() <= 8
          && d.name.matches('^[가-힣A-Za-z0-9_ ]+$')
          && d.score is number
          && d.at == request.time
          && d.v == 2
          && (
            (mode == 'race' && d.score >= 20 && d.score <= 3600)
            || (mode != 'race' && d.score is int && d.score > 0 && d.score <= 200000 && d.score % 5 == 0)
          );
      }
      allow read: if okMode();
      allow create: if okMode() && pid.matches('^[A-Za-z0-9]{8,64}$') && ok(request.resource.data);
      allow update: if okMode() && ok(request.resource.data)
        && (mode == 'race'
          ? request.resource.data.score <= resource.data.score
          : request.resource.data.score >= resource.data.score);
      allow delete: if false;
    }
  }
}
