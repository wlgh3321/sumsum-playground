// 셈셈 놀이터 순위표 보안 규칙
// - 누구나 읽을 수 있어요.
// - 새 기록 추가만 돼요. 고치거나 지우기는 막아요.
// - 이름은 1~8글자(한글·영문·숫자·_·공백), 점수는 말이 되는 범위만 받아요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{mode}/scores/{id} {
      allow read: if mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf'];

      allow create: if mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf']
        && request.resource.data.keys().hasOnly(['name', 'score', 'at', 'v', 'country'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 8
        && request.resource.data.name.matches('^[가-힣A-Za-z0-9_ ]+$')
        && request.resource.data.score is number
        && request.resource.data.at == request.time
        && request.resource.data.v == 1
        && (!('country' in request.resource.data)
          || (request.resource.data.country is string && request.resource.data.country.matches('^[A-Z]{2}$')))
        && (
          (mode == 'race'
            && request.resource.data.score >= 20
            && request.resource.data.score <= 3600)
          || (mode != 'race'
            && request.resource.data.score is int
            && request.resource.data.score > 0
            && request.resource.data.score <= 5000000
            && request.resource.data.score % 5 == 0)
        );

      allow update, delete: if false;
    }

    // 그룹 경쟁전: 링크를 받은 사람끼리만 겨루는 방. 방 하나에서 게임 6개를 모두 겨뤄요.
    // - 문제는 24시간마다 바뀌고, 72시간(3일)마다 순위만 새로 시작해요(회차). 방은 방장이 지울 때까지 남아요.
    // - 방: 문제 씨앗 + 방 이름 + 만든 사람 닉네임 + 방장(익명 로그인 번호)
    // - names/{닉네임}: 이 방에서 그 닉네임을 쓰는 기기 (먼저 쓴 사람 것 → 같은 방 닉네임 중복 막기)
    // - boards/{게임_회차}/players/{기기}: 회차·게임마다 기기당 한 줄, 더 좋은 기록으로만 고칠 수 있어요
    match /rooms/{rid} {
      function okName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
      allow read: if true;
      allow create: if rid.matches('^[A-Za-z0-9]{6,32}$')
        && request.auth != null
        && request.resource.data.keys().hasOnly(['seed', 'host', 'name', 'owner', 'at', 'v'])
        && request.resource.data.seed is int
        && request.resource.data.seed > 0
        && request.resource.data.seed < 2147483648
        && request.resource.data.host is string
        && request.resource.data.host.size() <= 8
        && (request.resource.data.host.size() == 0 || request.resource.data.host.matches('^[가-힣A-Za-z0-9_ ]+$'))
        && okName(request.resource.data.name)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.v == 3;
      // 방장만: 이름 바꾸기, 방 지우기
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && okName(request.resource.data.name);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      function room() { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
      // 지금 회차: 방을 만든 때부터 72시간(3일)마다 1씩
      function season() { return math.floor((request.time.toMillis() - room().at.toMillis()) / 259200000.0); }

      match /names/{key} {
        allow read: if true;
        allow create: if room().v == 3
          && request.resource.data.keys().hasOnly(['pid'])
          && request.resource.data.pid is string
          && request.resource.data.pid.matches('^[A-Za-z0-9]{8,64}$');
        allow update, delete: if false;
      }

      match /boards/{bid}/players/{pid} {
        function mode() { return bid.split('_')[0]; }
        function ok(d) {
          return bid.matches('^(fall|minute|race|balloon|beat|tf)_[0-9]{1,5}$')
            && int(bid.split('_')[1]) == season()
            && d.keys().hasOnly(['name', 'score', 'at', 'v', 'country'])
            && d.name is string
            && d.name.size() >= 1
            && d.name.size() <= 8
            && d.name.matches('^[가-힣A-Za-z0-9_ ]+$')
            && d.score is number
            && d.at == request.time
            && d.v == 3
            && (!('country' in d) || (d.country is string && d.country.matches('^[A-Z]{2}$')))
            && (
              (mode() == 'race' && d.score >= 20 && d.score <= 3600)
              || (mode() != 'race' && d.score is int && d.score > 0 && d.score <= 5000000 && d.score % 5 == 0)
            )
            // 닉네임 주인이 이 기기여야 해요
            && getAfter(/databases/$(database)/documents/rooms/$(rid)/names/$(d.name.lower().replace(' ', ''))).data.pid == pid;
        }
        allow read: if true;
        allow create: if pid.matches('^[A-Za-z0-9]{8,64}$') && ok(request.resource.data);
        // 고치기: 같은 이름으로 더 좋은 기록, 또는 기록은 그대로 두고 닉네임만 바꾸기
        allow update: if ok(request.resource.data)
          && (
            (request.resource.data.name == resource.data.name
              && (mode() == 'race'
                ? request.resource.data.score < resource.data.score
                : request.resource.data.score > resource.data.score))
            || (request.resource.data.name != resource.data.name
              && request.resource.data.score == resource.data.score)
          );
        allow delete: if false;
      }
    }

    // 앱 설정 (전면 광고 횟수 등): 누구나 읽기만, 고치기는 콘솔에서만
    match /config/{name} {
      allow read: if true;
      allow write: if false;
    }

    // 앱 명예의 전당: 사람(기기)마다 한 줄. 더 좋은 기록으로만 고칠 수 있어요.
    match /boards/{mode}/players/{pid} {
      function okMode() { return mode in ['fall', 'minute', 'race', 'balloon', 'beat', 'tf']; }
      function ok(d) {
        return d.keys().hasOnly(['name', 'score', 'at', 'v', 'country'])
          && d.name is string
          && d.name.size() >= 1
          && d.name.size() <= 8
          && d.name.matches('^[가-힣A-Za-z0-9_ ]+$')
          && d.score is number
          && d.at == request.time
          && d.v == 2
          && (!('country' in d) || (d.country is string && d.country.matches('^[A-Z]{2}$')))
          && (
            (mode == 'race' && d.score >= 20 && d.score <= 3600)
            || (mode != 'race' && d.score is int && d.score > 0 && d.score <= 5000000 && d.score % 5 == 0)
          );
      }
      allow read: if okMode();
      allow create: if okMode() && pid.matches('^[A-Za-z0-9]{8,64}$') && ok(request.resource.data);
      allow update: if okMode() && ok(request.resource.data)
        && (mode == 'race'
          ? request.resource.data.score <= resource.data.score
          : request.resource.data.score >= resource.data.score);
      allow delete: if false;
    }
  }
}
